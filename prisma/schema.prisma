// Brito - Multi-store food delivery platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== AUTH & PROFILES ======

model Profile {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles  UserRole[]
  stores Store[]
  orders Order[]
}

model UserRole {
  id        String   @id @default(cuid())
  profileId String
  role      String   @default("CUSTOMER") // CUSTOMER | OWNER
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, role])
}

// ====== STORES & MENU ======

model Store {
  id            String   @id @default(cuid())
  ownerId       String
  slug          String   @unique
  name          String
  description   String?
  category      String   // pizza, burger, japones, doces, saudavel, mexicano, etc.
  logoUrl       String?
  coverUrl      String?
  address       String?
  cep           String?
  phone         String?
  openingHours  String?
  deliveryFee   Float    @default(0)
  minOrder      Float    @default(0)
  avgDeliveryMin Int     @default(30)
  rating        Float    @default(4.5)
  // Pagamento
  pixKey        String?
  paymentLink   String?  // link de checkout de cartão (ex: Stripe, Mercado Pago)
  // Estado
  isActive      Boolean  @default(true)
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       Profile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuSections MenuSection[]
  menuItems   MenuItem[]
  orders      Order[]

  @@index([category])
  @@index([isActive])
}

model MenuSection {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@index([storeId])
}

model MenuItem {
  id           String   @id @default(cuid())
  sectionId    String
  storeId      String
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section    MenuSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId])
  @@index([sectionId])
}

// ====== ORDERS ======

model Order {
  id            String   @id @default(cuid())
  orderNumber   Int
  storeId       String
  customerId    String
  status        String   @default("PENDING") // PENDING, ACCEPTED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  // Dados do cliente (snapshot)
  customerName  String
  customerPhone String
  // Endereço de entrega
  cep           String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  // Pagamento
  paymentMethod String   // PIX | CARD | ON_DELIVERY
  paymentDetail String?  // ex: "Dinheiro, troco para R$ 50" ou "Pago via link"
  // Valores
  subtotal      Float
  deliveryFee   Float
  total         Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Profile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  itemId     String
  name       String
  unitPrice  Float
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  MenuItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
