// Brito - Multi-store food delivery platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====== AUTH & PROFILES ======

model Profile {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       UserRole[]
  stores      Store[]
  orders      Order[]
  memberships StoreMember[]
}

model UserRole {
  id        String   @id @default(cuid())
  profileId String
  role      String   @default("CUSTOMER") // CUSTOMER | OWNER
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, role])
}

// ====== STORES & MENU ======

model Store {
  id            String   @id @default(cuid())
  ownerId       String
  slug          String   @unique
  name          String
  description   String?
  category      String
  logoUrl       String?
  coverUrl      String?
  address       String?
  cep           String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  phone         String?
  whatsapp      String?
  email         String?
  openingHours  String?
  deliveryFee   Float    @default(0)
  minOrder      Float    @default(0)
  avgDeliveryMin Int     @default(30)
  rating        Float    @default(4.5)
  // Redes sociais
  instagram     String?
  tiktok        String?
  facebook      String?
  // Banners (JSON array de {url, link})
  banners       String?
  // Horário por dia (JSON: {mon: {open: true, from: "18:00", to: "23:00"}, ...})
  businessHours String?
  // Config de entrega
  deliveryActive     Boolean @default(true)
  deliveryMode       String  @default("FIXED") // FIXED | BASE_KM | AREAS
  deliveryBaseFee    Float   @default(0)
  deliveryPerKm      Float   @default(0)
  deliveryMaxKm      Float   @default(10)
  freeDeliveryAbove  Float?
  // Pagamento
  pixKey        String?
  paymentLink   String?
  paymentGateway String? // "stripe" | "mercadopago" | null
  paymentConnected Boolean @default(false)
  // Impressora
  printerMode       String  @default("BROWSER") // BROWSER | PRINTNODE | QZ
  printerCopies     Int     @default(1)
  printerWidth      String  @default("80mm")
  printerAutoPrint  Boolean @default(false)
  printerAutoReport Boolean @default(false)
  // Mensagens auto WhatsApp
  autoMessagesEnabled Boolean @default(false)
  autoMessages  String? // JSON com templates por status
  trackingText  String?
  // Domínio próprio
  customDomain  String?
  domainVerified Boolean @default(false)
  // Trial
  trialEndsAt   DateTime?
  // Estado
  isActive      Boolean  @default(true)
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       Profile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuSections MenuSection[]
  menuItems   MenuItem[]
  orders      Order[]
  drivers     DeliveryDriver[]
  kitchenAreas KitchenArea[]
  members     StoreMember[]

  @@index([category])
  @@index([isActive])
}

model MenuSection {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@index([storeId])
}

model MenuItem {
  id           String   @id @default(cuid())
  sectionId    String
  storeId      String
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section    MenuSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId])
  @@index([sectionId])
}

// ====== DELIVERY ======

model DeliveryDriver {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ====== KITCHEN ======

model KitchenArea {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  color     String   @default("#E85D2C")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ====== STORE MEMBERS (Users & Permissions) ======

model StoreMember {
  id        String   @id @default(cuid())
  storeId   String
  profileId String
  role      String   @default("OWNER") // OWNER | MANAGER | STAFF
  createdAt DateTime @default(now())

  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  profile  Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([storeId, profileId])
  @@index([storeId])
}

// ====== ORDERS ======

model Order {
  id            String   @id @default(cuid())
  orderNumber   Int
  storeId       String
  customerId    String
  status        String   @default("PENDING") // PENDING, ACCEPTED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  customerName  String
  customerPhone String
  cep           String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  paymentMethod String
  paymentDetail String?
  subtotal      Float
  deliveryFee   Float
  total         Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Profile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([storeId, status])
  @@index([customerId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  itemId     String
  name       String
  unitPrice  Float
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  MenuItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
